# One `<path-glob>[:<category>]  # reason` per line. Categories: owner-path, email,
# project-ref, supabase-key, jwt, slack-id, secret[:<rule>], gitleaks-ignore, denylist[:<category>].
scripts/strip-check.sh  # the gate itself names the patterns it looks for
lib/cli-lint.sh         # the linter names the owner paths it refuses
tests/strip_check.sh    # plants fake keys and owner paths on purpose, in a temp copy
tests/cli_lint.sh       # plants owner paths in temp skills on purpose
README.md:email          # the public contact address, on purpose
.github/workflows/checks.yml:email  # the placeholder git identity tests commit with in CI
